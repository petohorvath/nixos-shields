# Agent-flow scratch space: the spec and ticket drafts live on GitHub
# Issues; the local copies are working files, not source.
.scratch/

# The example consumer's inputs are overridden when it is checked;
# a lock written by running it by hand is not source.
examples/*/flake.lock

# nix build output symlinks
result
result-*

# editor autosave/backup files
*~
\#*\#
.\#*

# nix-direnv cache and per-user envrc overrides
.direnv/
.envrc.local

# Local Claude instructions, not part of the published library.
CLAUDE.md
