Backport nix-plugins 16.0.1 to build against Nix 2.34.

Upstream nix-plugins (including master) has not been updated for the
Nix 2.31 -> 2.34 C++ API churn, and nixpkgs sidesteps it by building
the package against nixComponents_2_31. The kit instead builds
nix-plugins against the same Nix its wrapped binary set runs (the 2.34
series), so the required fixes are backported here. The three hunks
below carry four changes:

  * Setting<Path> -> Setting<std::string>: the Path alias is no longer
    in scope through the headers this file includes.
  * Settings::nixConfDir was removed; hardcode the default
    extra-builtins-file path. The wrapped Nix always sets
    extra-builtins-file through NIX_CONFIG, so this default is never
    consulted in practice.
  * PrimOp::fun was renamed to PrimOp::impl (now fun<PrimOpFun> impl);
    four occurrences across the exec, importNative, __extraBuiltins and
    __nix-cflags registrations.
  * Value::mkString now takes an EvalMemory & argument (Nix 2.33,
    NixOS/nix#14584); pass state.mem. This hunk is shlevy/nix-plugins#25.

Drop this patch once a nix-plugins release builds against the Nix
version lib.mkNix defaults to; newer Nix may also need new hunks.

--- a/extra-builtins.cc
+++ b/extra-builtins.cc
@@ -12,8 +12,8 @@
 using namespace nix;
 
 struct ExtraBuiltinsSettings : Config {
-    Setting<Path> extraBuiltinsFile{this,
-        settings.nixConfDir + "/extra-builtins.nix",
+    Setting<std::string> extraBuiltinsFile{this,
+        "/etc/nix/extra-builtins.nix",
             "extra-builtins-file",
             "The path to a nix expression defining extra expression-language level builtins."};
 };
@@ -42,14 +42,14 @@
             attrs.alloc(sExec).mkPrimOp(new PrimOp {
                 .name = "exec",
                 .arity = 1,
-                .fun = prim_exec,
+                .impl = prim_exec,
             });
 
             auto sImportNative = state.symbols.create("importNative");
             attrs.alloc(sImportNative).mkPrimOp(new PrimOp {
                 .name = "importNative",
                 .arity = 2,
-                .fun = prim_importNative,
+                .impl = prim_importNative,
             });
 
             arg = state.allocValue();
@@ -65,21 +65,21 @@
 static RegisterPrimOp rp1({
     .name = "__extraBuiltins",
     .arity = 0,
-    .fun = extraBuiltins,
+    .impl = extraBuiltins,
 });
 
 static void cflags(EvalState & state, const PosIdx _pos,
     Value ** _args, Value & v)
 {
     auto attrs = state.buildBindings(3);
-    attrs.alloc("NIX_INCLUDE_DIRS").mkString(NIX_INCLUDE_DIRS);
-    attrs.alloc("NIX_CFLAGS_OTHER").mkString(NIX_CFLAGS_OTHER);
-    attrs.alloc("BOOST_INCLUDE_DIR").mkString(BOOST_INCLUDE_DIR);
+    attrs.alloc("NIX_INCLUDE_DIRS").mkString(NIX_INCLUDE_DIRS, state.mem);
+    attrs.alloc("NIX_CFLAGS_OTHER").mkString(NIX_CFLAGS_OTHER, state.mem);
+    attrs.alloc("BOOST_INCLUDE_DIR").mkString(BOOST_INCLUDE_DIR, state.mem);
     v.mkAttrs(attrs);
 }
 
 static RegisterPrimOp rp2({
     .name = "__nix-cflags",
     .arity = 0,
-    .fun = cflags,
+    .impl = cflags,
 });
